# ==============================================================================
# X FIT FORMULA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your actual values.
# The .env.local file is git-ignored — NEVER commit actual credentials.
#
# Get these values from: https://supabase.com/dashboard/project/YOUR-REF/settings/api
# ==============================================================================

# ── Frontend (browser-safe) ────────────────────────────────────────────────────
# These are embedded in the Vite build and visible in the browser bundle.
# They are safe to use in React code — the anon key has RLS restrictions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Scripts only (server-side / local terminal only) ───────────────────────────
# NEVER put these in React/Vite code.
# NEVER put these in Netlify environment variables (frontend build).
# NEVER commit these values to git.
# Use ONLY in Node scripts run locally: import-exercises.js, upload-exercise-media.js
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
