<svg xmlns="http://www.w3.org/2000/svg" width="640" height="640" viewBox="0 0 640 640">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#141414"/>
      <stop offset="100%" stop-color="#050505"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0c49b"/>
      <stop offset="50%" stop-color="#c6a87c"/>
      <stop offset="100%" stop-color="#9a8260"/>
    </linearGradient>
  </defs>
  <rect width="640" height="640" fill="url(#bg)"/>
  <rect x="20" y="20" width="600" height="600" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
  
  <!-- Subtle circular grid -->
  <circle cx="320" cy="270" r="150" fill="none" stroke="url(#gold)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.3"/>
  <circle cx="320" cy="270" r="110" fill="rgba(198,168,124,0.03)"/>
  
  <!-- Central Emblem & Play Symbol -->
  <circle cx="320" cy="270" r="44" fill="#050505" stroke="url(#gold)" stroke-width="2"/>
  <polygon points="314,254 336,270 314,286" fill="#c6a87c"/>
  
  <!-- Tag / Level Category -->
  <rect x="220" y="370" width="200" height="24" rx="12" fill="rgba(198,168,124,0.12)" stroke="rgba(198,168,124,0.3)" stroke-width="1"/>
  <text x="320" y="386" text-anchor="middle" font-family="'Inter', sans-serif" font-size="10" font-weight="700" fill="#c6a87c" letter-spacing="2">
    HOME WORKOUT • TUTORIAL
  </text>

  <!-- Exercise Title -->
  <text x="320" y="440" text-anchor="middle" font-family="'Syne', 'Inter', system-ui" font-size="24" font-weight="800" fill="#f5f5f5" letter-spacing="2">
    INCLINE PUSH-UPS
  </text>
  
  <!-- Target Muscle -->
  <text x="320" y="472" text-anchor="middle" font-family="'Inter', system-ui" font-size="13" font-weight="600" fill="#888888" letter-spacing="3">
    PECTORALIS MAJOR
  </text>
  
  <!-- Footnote -->
  <text x="320" y="550" text-anchor="middle" font-family="'Inter', system-ui" font-size="9" font-weight="700" fill="rgba(255,255,255,0.2)" letter-spacing="4">
    X FIT FORMULA — PRODUCTION LIBRARY
  </text>
</svg>